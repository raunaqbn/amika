# Turso Database
TURSO_DATABASE_URL=your-turso-database-url-here
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Google OAuth (for Sign in with Google)
# Get your credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# App URL (required for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider Configuration
# Choose one: 'google', 'anthropic', or 'openai'
AI_PROVIDER=google

# Google AI (Gemini) API Key
# Get your key from: https://aistudio.google.com/apikey
# Note: Use stable models (not -exp) for free tier availability
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash

# Anthropic (Claude) API Key
# Get your key from: https://console.anthropic.com/
# Note: Claude 3.5 was retired, use Claude 4.x models
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
