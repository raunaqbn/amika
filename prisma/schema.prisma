// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  birthday     DateTime?
  profileImage String?
  interests    String?   // JSON array of interest IDs like ["hiking", "wine", "live-music"]
  createdAt    DateTime  @default(now())
  sessions     Session[]
  friends      Friend[]
  memories     Memory[]
  diaryNotes   DiaryNote[]
  events       Event[]
  chatTranscripts ChatTranscript[]
  wishlistItems WishlistItem[]
  googleAccount GoogleAccount?
  // User connections (friend requests between Amika users)
  connectionsSent     UserConnection[] @relation("ConnectionRequester")
  connectionsReceived UserConnection[] @relation("ConnectionAddressee")
  // Shared items
  itemsShared    SharedItem[] @relation("SharedByUser")
  itemsReceived  SharedItem[] @relation("SharedWithUser")
  // Trip planning
  tripSessions   TripSession[]
  tripMessages   TripMessage[]
}

// Google OAuth account for Calendar integration
model GoogleAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String   // Google account email
  accessToken  String   // OAuth access token
  refreshToken String   // OAuth refresh token for obtaining new access tokens
  tokenExpiry  DateTime // When the access token expires
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Friend {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String?   // Email address for calendar invites (for non-Amika friends)
  birthday     DateTime?
  howWeMet     String?
  notes        String?
  interests    String?   // JSON array of interest IDs like ["hiking", "wine", "live-music"]
  lastContact  DateTime?
  profileImage String?   // Default profile image (synced for Amika friends, user-set for regular friends)
  customProfileImage String?  // User-uploaded custom image that overrides the default
  linkedUserId String?   // If set, this friend is linked to an Amika user
  createdAt    DateTime  @default(now())
  memories     Memory[]
  events       Event[]
  diaryNoteTags DiaryNoteTag[]
  tripCollaborations TripCollaborator[]
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
}

model DiaryNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  analysis  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      DiaryNoteTag[]
}

model DiaryNoteTag {
  noteId    String
  note      DiaryNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  friendId  String
  friend    Friend    @relation(fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([noteId, friendId])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventDate   DateTime
  location    String?
  category    String?  // experiences, restaurants, places
  friendId    String
  friend      Friend   @relation(fields: [friendId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model ChatTranscript {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
}

// User-to-user connections (adding friends from existing Amika users)
model UserConnection {
  id          String   @id @default(cuid())
  requesterId String   // User who sent the friend request
  requester   User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String   // User who received the friend request
  addressee   User     @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending, accepted, rejected
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
}

// Shared items between connected users
model SharedItem {
  id             String   @id @default(cuid())
  sharedByUserId String   // User who shared the item
  sharedBy       User     @relation("SharedByUser", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWithUserId String // User receiving the shared item
  sharedWith     User     @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  itemType       String   // memory, note, event
  itemId         String   // ID of the memory, note, or event
  status         String   @default("pending") // pending, accepted, rejected
  message        String?  // Optional message from sharer
  createdAt      DateTime @default(now())

  @@unique([sharedByUserId, sharedWithUserId, itemType, itemId])
}

// User wishlist items
model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  link        String?  // URL to product/experience
  price       String?  // Price as string to handle different formats
  category    String?  // gift, experience, travel, tech, home, fashion, other
  priority    Int      @default(0) // 0=normal, 1=high, 2=top priority
  imageUrl    String?
  purchased   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Collaborative Trip Planning Models

model TripSession {
  id              String   @id @default(cuid())
  userId          String   // Creator of the trip
  title           String
  description     String?
  status          String   @default("planning") // "planning", "confirmed", "completed", "cancelled"

  // Trip Goals (nullable until decided)
  startDate       DateTime?
  endDate         DateTime?
  location        String?
  locationDetails String?  // JSON string: {city, country, coordinates, etc.}

  // Public sharing
  shareToken      String?  @unique  // Token for public shareable link

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators   TripCollaborator[]
  dailyPlans      TripDailyPlan[]
  tickets         TripTicket[]
  messages        TripMessage[]
  polls           TripPoll[]
  goalProgress    TripGoalProgress[]

  @@index([userId])
}

model TripCollaborator {
  id          String   @id @default(cuid())
  tripId      String
  friendId    String   // Reference to Friend model (can be linked Amika user)
  userId      String?  // If friend is a linked Amika user, store their userId
  role        String   @default("collaborator") // "owner", "collaborator"
  joinedAt    DateTime @default(now())

  trip        TripSession @relation(fields: [tripId], references: [id], onDelete: Cascade)
  friend      Friend      @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([tripId, friendId])
  @@index([tripId])
  @@index([userId])
}

model TripDailyPlan {
  id          String   @id @default(cuid())
  tripId      String
  dayNumber   Int      // Day 1, Day 2, etc.
  date        DateTime?

  events      TripEvent[]
  trip        TripSession @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model TripEvent {
  id            String   @id @default(cuid())
  dailyPlanId   String
  title         String
  description   String?
  startTime     String?  // "09:00", "14:30" etc.
  endTime       String?
  location      String?
  category      String?  // "experiences", "restaurants", "places", "fitness", "virtual"
  externalUrl   String?  // Link to event/venue
  estimatedCost Float?
  notes         String?
  order         Int      @default(0) // For drag-drop reordering

  createdById   String   // Who added this event
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailyPlan     TripDailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  @@index([dailyPlanId])
}

model TripTicket {
  id              String   @id @default(cuid())
  tripId          String
  collaboratorId  String?  // Which collaborator this ticket is for
  type            String   // "flight", "train", "bus", "accommodation", "activity", "other"
  title           String
  description     String?
  confirmationNum String?
  departureTime   DateTime?
  arrivalTime     DateTime?
  location        String?
  cost            Float?
  currency        String   @default("USD")
  url             String?  // Booking link

  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trip            TripSession @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([collaboratorId])
}

model TripMessage {
  id          String   @id @default(cuid())
  tripId      String
  userId      String   // Who sent the message
  friendId    String?  // If sent by a non-Amika friend (display purposes)
  context     String   @default("general") // "general", "dates", "location", "events", "tickets"
  role        String   // "user", "assistant" (for Amika AI responses)
  content     String
  createdAt   DateTime @default(now())

  trip        TripSession @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])

  @@index([tripId, context])
  @@index([tripId, createdAt])
}

model TripPoll {
  id          String   @id @default(cuid())
  tripId      String
  context     String   // "dates", "location", "events", "tickets"
  question    String
  status      String   @default("active") // "active", "closed"
  createdById String
  createdAt   DateTime @default(now())
  closedAt    DateTime?

  options     TripPollOption[]
  trip        TripSession @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, context])
}

model TripPollOption {
  id          String   @id @default(cuid())
  pollId      String
  label       String
  url         String?  // Optional link (e.g., to event, venue, etc.)
  order       Int      @default(0)

  votes       TripPollVote[]
  poll        TripPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
}

model TripPollVote {
  id          String   @id @default(cuid())
  optionId    String
  visitorId   String?  // If voter is Amika user
  friendId    String?  // If voter is a non-linked friend
  votedAt     DateTime @default(now())

  option      TripPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, visitorId])
  @@unique([optionId, friendId])
  @@index([optionId])
}

model TripGoalProgress {
  id          String   @id @default(cuid())
  tripId      String
  goalType    String   // "dates", "location", "daily_events", "tickets"
  status      String   @default("pending") // "pending", "in_progress", "completed"
  completedAt DateTime?

  trip        TripSession @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, goalType])
  @@index([tripId])
}
