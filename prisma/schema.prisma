datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  birthday     DateTime?
  profileImage String?
  phone        String?
  location     String?
  googleId     String?   @unique
  isTemporary  Boolean   @default(false)
  interests    String?
  createdAt    DateTime  @default(now())

  sessions            Session[]
  friends             Friend[]
  memories            Memory[]
  memoryReactions     MemoryReaction[]
  memoryComments      MemoryComment[]
  diaryNotes          DiaryNote[]
  chatTranscripts     ChatTranscript[]
  connectionsSent     UserConnection[] @relation("ConnectionRequester")
  connectionsReceived UserConnection[] @relation("ConnectionAddressee")
  itemsShared         SharedItem[] @relation("SharedByUser")
  itemsReceived       SharedItem[] @relation("SharedWithUser")
  messagesSent        DirectMessage[] @relation("MessageSender")
  messagesReceived    DirectMessage[] @relation("MessageRecipient")
  groupConversationsCreated GroupConversation[] @relation("GroupCreator")
  groupConversationMemberships GroupConversationMember[]
  groupMessagesSent   GroupMessage[] @relation("GroupMessageSender")
  pushTokens          PushToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Friend {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  birthday           DateTime?
  howWeMet           String?
  notes              String?
  interests          String?
  lastContact        DateTime?
  profileImage       String?
  customProfileImage String?
  linkedUserId       String?
  createdAt          DateTime  @default(now())
  memories           Memory[]
  diaryNoteTags      DiaryNoteTag[]
}

model Memory {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendId              String?
  friend                Friend?  @relation(fields: [friendId], references: [id], onDelete: Cascade)
  amikaFriendUserId     String?
  content               String
  imageUrl              String?
  visibility            String   @default("private")
  memoryDate             DateTime @default(now())
  sharedWithFriend       Boolean  @default(false)
  sharedWithAmikaFriend  Boolean  @default(false)
  createdAt              DateTime @default(now())
  reactions              MemoryReaction[]
  comments               MemoryComment[]

  @@index([userId, memoryDate])
  @@index([visibility, memoryDate])
}

model MemoryReaction {
  id        String   @id @default(cuid())
  memoryId  String
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String   @default("heart")
  createdAt DateTime @default(now())

  @@unique([memoryId, userId, emoji])
}

model MemoryComment {
  id        String   @id @default(cuid())
  memoryId  String
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([memoryId, createdAt])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model GroupConversation {
  id        String   @id @default(cuid())
  createdBy String
  creator   User     @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  members   GroupConversationMember[]
  messages  GroupMessage[]

  @@map("group_conversations")
}

model GroupConversationMember {
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@map("group_conversation_members")
}

model GroupMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("group_messages")
}

model DiaryNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  analysis  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      DiaryNoteTag[]
}

model DiaryNoteTag {
  noteId           String
  note             DiaryNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  friendId         String
  friend           Friend    @relation(fields: [friendId], references: [id], onDelete: Cascade)
  sharedWithFriend Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@id([noteId, friendId])
}

model ChatTranscript {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model UserConnection {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
}

model SharedItem {
  id               String   @id @default(cuid())
  sharedByUserId   String
  sharedBy         User     @relation("SharedByUser", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWithUserId String
  sharedWith       User     @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  itemType         String
  itemId           String
  status           String   @default("pending")
  message          String?
  createdAt        DateTime @default(now())

  @@unique([sharedByUserId, sharedWithUserId, itemType, itemId])
}

model PushToken {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  updatedAt DateTime @updatedAt

  @@index([userId])
}
